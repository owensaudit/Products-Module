rules_version = '2';
// Assumed data model: one document, portal/state, written only by the
// portal server with the Admin SDK. Browsers never read or write Firestore.
// Fields: people, outreachAttempts, visits, comments, importMeta,
// presidency, youthLeadership, directory.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
